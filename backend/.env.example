# Server Configuration
PORT=5050
NODE_ENV=development

# Frontend URL(s) for CORS in production (comma-separated). Example:
# FRONTEND_URL=https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173

# Auth — REQUIRED for login/register. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Get one free at https://aistudio.google.com/
GEMINI_API_KEY=
# Optional model override (default chain: gemini-2.5-flash -> gemini-flash-latest -> gemini-2.5-flash-lite)
GEMINI_MODEL=

# Cloudinary Credentials
# Sign up free at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB URI (Optional - defaults to in-memory store if left empty)
MONGODB_URI=
