# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# Environment variables - NEVER commit secrets
# Keeps .env.example tracked as template, ignores real .env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
!*.env.example
!.env.example
!**/.env.example

# Build outputs (Vite + Node)
dist/
**/dist/
build/
frontend/dist/
backend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend-dev.log
frontend-dev.log

# Uploads / temp files (multer, local previews)
uploads/
tmp/
temp/
*.tmp

# OS files (Windows / macOS / Linux)
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.vim/

# Testing / coverage
coverage/
.nyc_output/
*.lcov

# Misc
.cache/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
